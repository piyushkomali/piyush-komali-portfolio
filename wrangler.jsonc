{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "piyushkomali",
  "pages_build_output_dir": "./out",
  "vars": {
    "BUN_VERSION": "1.4.2",
    "SKIP_DEPENDENCY_INSTALL": "1"
  },
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI",
    "remote": true
  }
}
